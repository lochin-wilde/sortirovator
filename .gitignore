# Secrets. The app takes keys from the environment or from the user; none of
# them belong in the repository. Kept first so it is the first thing read.
.env
.env.*
*.key
secrets.json

# Virtualenvs and caches — rebuildable, and large.
.venv/
venv/
__pycache__/
.pycache/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*

# Generated by tooling, not sources.
graphify-out/
tmp_bp/

# The abandoned Tauri attempt (26 MB). The browser version replaced it; keeping
# it in history would cost more than it is worth. Delete the directory once you
# are sure nothing in it is still wanted.
music-sorter-tauri/

# Ground-truth exports and analysis caches. These describe a private music
# library — track titles, artists, folder layout — and are not ours to publish.
# The measurement harness reads them from outside the repo by design.
sets.json
analysis_cache.json
*.rekordbox.txt
ground-truth/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
.vscode/
*.swp

# Локальные значения секретов гейта — задаются в Cloudflare, не здесь.
.dev.vars
wrangler.toml.local
