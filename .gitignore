# Secrets. The app takes keys from the environment or from the user; none of
# them belong in the repository. Kept first so it is the first thing read.
.env
.env.*
*.key
secrets.json

# Virtualenvs and caches — rebuildable, and large.
.venv/
venv/
__pycache__/
.pycache/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*

# Generated by tooling, not sources.
graphify-out/
tmp_bp/

# The abandoned Tauri attempt. Its build output reappears whenever the
# directory is opened in an editor, and it is 16 MB of artifacts that the
# browser version replaced.
music-sorter-tauri/

# Ground-truth exports and analysis caches. These describe a private music
# library — track titles, artists, folder layout — and are not ours to publish.
# The measurement harness reads them from outside the repo by design.
sets.json
analysis_cache.json
*.rekordbox.txt
ground-truth/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
.vscode/
*.swp

# Local values for the gate's secrets. They are set in Cloudflare, not here.
.dev.vars
wrangler.toml.local
